{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: Build Release APK",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "apk",
                "--release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Flutter: Build Release APK (split per ABI)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "apk",
                "--release",
                "--split-per-abi"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Build App Bundle (release)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "appbundle",
                "--release"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
